# ZJY400-8532ANT RGB panel and suniv display pipeline
CONFIG_CMA=y
CONFIG_DMA_CMA=y
# One 720x720 XRGB8888 scanout buffer is about 1.98 MiB. Six MiB leaves room
# for two buffers plus alignment while returning 2 MiB to normal allocations.
CONFIG_CMA_SIZE_MBYTES=6
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_KMS_FB_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_FBDEV_OVERALLOC=100
CONFIG_DRM_GEM_CMA_HELPER=y
CONFIG_DRM_KMS_CMA_HELPER=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN4I_BACKEND=y
# CONFIG_DRM_SUN4I_HDMI is not set
CONFIG_DRM_PANEL=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_BRIDGE=y
CONFIG_DRM_PANEL_BRIDGE=y
# CONFIG_DRM_LOAD_EDID_FIRMWARE is not set
# CONFIG_DRM_PANEL_ORIENTATION_QUIRKS is not set

# /dev/fb0, framebuffer console, and boot logo
CONFIG_FB=y
CONFIG_FB_CFB_FILLRECT=y
CONFIG_FB_CFB_COPYAREA=y
CONFIG_FB_CFB_IMAGEBLIT=y
CONFIG_FB_SYS_FILLRECT=y
CONFIG_FB_SYS_COPYAREA=y
CONFIG_FB_SYS_IMAGEBLIT=y
CONFIG_FB_SIMPLE=y
# CONFIG_FB_DEFERRED_IO is not set
# CONFIG_FB_MODE_HELPERS is not set
# CONFIG_FB_TILEBLITTING is not set
# CONFIG_FB_FOREIGN_ENDIAN is not set
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER=y
CONFIG_FONT_SUPPORT=y
CONFIG_FONT_8x8=y
CONFIG_FONT_8x16=y
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_MONO=y
CONFIG_LOGO_LINUX_VGA16=y
CONFIG_LOGO_LINUX_CLUT224=y

# Use XZ-compressed SquashFS so the complete Wi-Fi/AP rootfs and a writable
# JFFS2 overlay both fit in the 16 MiB SPI-NOR layout.
CONFIG_SQUASHFS_XZ=y
# CONFIG_SQUASHFS_ZLIB is not set

# Fixed panel rail and PE12 PWM backlight
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_PWM=y
CONFIG_PWM=y
CONFIG_PWM_SUN4I=y

# IPv4 filtering/NAT for an optional routed AP uplink
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_TARGET_MASQUERADE=y

# Low-memory production profile. The board has no audio codec wiring, camera,
# video decoder output, USB gadget function, EHCI/OHCI controller, or HID port.
# U-Boot DFU is independent of the Linux USB gadget configuration.
# CONFIG_SOUND is not set
# CONFIG_MEDIA_SUPPORT is not set
# CONFIG_VIDEO_SUNXI is not set
# TTY selects the input core, but the board has no input device described.
# CONFIG_INPUT_EVDEV is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_INPUT_TOUCHSCREEN is not set
# CONFIG_INPUT_POLLDEV is not set
# CONFIG_INPUT_FF_MEMLESS is not set
# CONFIG_HID is not set
# CONFIG_USB_HID is not set
# CONFIG_USB_STORAGE is not set
# CONFIG_USB_EHCI_HCD is not set
# CONFIG_USB_OHCI_HCD is not set
# CONFIG_USB_GADGET is not set
# CONFIG_USB_MUSB_DUAL_ROLE is not set
CONFIG_USB_MUSB_HOST=y

# The AIC8800 vendor driver is a full-MAC cfg80211 driver and does not use the
# in-kernel mac80211 data path.
# CONFIG_MAC80211 is not set

# NOR boots SquashFS and uses JFFS2 for the writable overlay. Keep MMC support
# for recovery/data cards, but omit unused block/NAND filesystems and drivers.
# CONFIG_EXT4_FS is not set
# CONFIG_MTD_NAND_CORE is not set
# CONFIG_MTD_SPI_NAND is not set
# CONFIG_SPI_SPIDEV is not set

# Features with persistent kernel bookkeeping or debug allocator overhead that
# are not needed by this single-purpose appliance.
# CONFIG_SWAP is not set
# CONFIG_CGROUPS is not set
# CONFIG_NAMESPACES is not set
# CONFIG_BLK_DEV_INITRD is not set
# CONFIG_AIO is not set
# CONFIG_IO_URING is not set
# CONFIG_PERF_EVENTS is not set
# CONFIG_SLUB_DEBUG is not set
