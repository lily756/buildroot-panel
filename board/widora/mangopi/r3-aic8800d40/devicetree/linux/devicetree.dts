/dts-v1/;
#include "suniv-f1c100s.dtsi"

/ {
	model = "Widora MangoPi R3 with AIC8800D40";
	compatible = "allwinner,suniv-f1c200s",
		     "allwinner,suniv-f1c100s";

	aliases {
		/* UART1 is routed to PA2/PA3 and is the only debug console. */
		serial0 = &uart1;
	};

	chosen {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;
		stdout-path = "serial0:115200n8";

		bootargs = "console=ttyS0,115200 earlycon rootwait init=/preinit root=/dev/mtdblock3 rootfstype=squashfs overlayfsdev=/dev/mtdblock4";

		/* Filled and enabled by U-Boot after the display is initialized. */
		simplefb_lcd: framebuffer-lcd0 {
			compatible = "allwinner,simple-framebuffer",
				     "simple-framebuffer";
			allwinner,pipeline = "de_be0-lcd0";
			clocks = <&ccu CLK_BUS_DE_BE>, <&ccu CLK_DE_BE>,
				 <&ccu CLK_DRAM_DE_BE>, <&ccu CLK_BUS_LCD>,
				 <&ccu CLK_TCON>;
			status = "disabled";
		};
	};

	backlight: backlight {
		compatible = "pwm-backlight";
		pwms = <&pwm 0 50000 0>;
		brightness-levels = <0 4 8 16 32 64 128 255>;
		default-brightness-level = <6>;

		/*
		 * The board only routes a PWM signal to the backlight circuit;
		 * there is no GPIO-controlled backlight power rail.  This phandle
		 * represents the already-present 3.3 V rail required by the Linux
		 * pwm-backlight driver and does not switch any pin or regulator.
		 */
		power-supply = <&reg_vcc3v3>;
	};

	panel: panel {
		compatible = "zjy,zjy400-8532ant";
		backlight = <&backlight>;

		/* The LCD logic supply is hard-wired; no enable GPIO exists. */
		power-supply = <&reg_vcc3v3>;

		port {
			panel_input: endpoint {
				remote-endpoint = <&tcon0_out_lcd>;
			};
		};
	};
};

&pio {
	/*
	 * RGB666 pinout from the schematic:
	 * PD0..5=B2..7, PD6..11=G2..7, PD12..17=R2..7,
	 * PD18=PCLK, PD19=DE, PD20=HSYNC, PD21=VSYNC.
	 */
	lcd_rgb666_pins: lcd-rgb666-pins {
		pins = "PD0", "PD1", "PD2", "PD3", "PD4", "PD5",
		       "PD6", "PD7", "PD8", "PD9", "PD10", "PD11",
		       "PD12", "PD13", "PD14", "PD15", "PD16", "PD17",
		       "PD18", "PD19", "PD20", "PD21";
		function = "lcd";
	};

	i2c2_pe_pins: i2c2-pe-pins {
		pins = "PE0", "PE1";
		function = "i2c2";
		bias-pull-up;
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x080000>;
				read-only;
			};

			partition@80000 {
				label = "splash";
				reg = <0x080000 0x080000>;
				read-only;
			};

			partition@100000 {
				label = "kernel";
				reg = <0x100000 0x500000>;
				read-only;
			};

			partition@600000 {
				label = "rom";
				reg = <0x600000 0x880000>;
				read-only;
			};

			partition@e80000 {
				label = "overlay";
				reg = <0xe80000 0x180000>;
			};
		};
	};
};

&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pa_pins>;
	status = "okay";
};

&mmc0 {
	broken-cd;
	status = "okay";
};

&otg_sram {
	status = "okay";
};

&usb_otg {
	dr_mode = "host";
	status = "okay";
};

&usbphy {
	status = "okay";
};

/* These inherited virtual rails have no corresponding control on this PCB. */
&reg_vcc3v0 {
	status = "disabled";
};

&reg_vcc5v0 {
	status = "disabled";
};

&de {
	status = "okay";
};

&fe0 {
	status = "okay";
};

&be0 {
	status = "okay";
};

&tcon0 {
	pinctrl-names = "default";
	pinctrl-0 = <&lcd_rgb666_pins>;
	status = "okay";
};

&tcon0_out {
	tcon0_out_lcd: endpoint@0 {
		reg = <0>;
		remote-endpoint = <&panel_input>;
	};
};

&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm0_pe_pins>;
	status = "okay";
};

&i2c2 {
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pe_pins>;
	status = "okay";
};
