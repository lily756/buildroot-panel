From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Buildroot Board Support <buildroot@example.com>
Date: Tue, 8 Sep 2026 15:00:00 +0800
Subject: [PATCH] usb: musb: trace sunxi bus connect state transitions

The AIC8800 boot ROM disconnects after its runtime firmware is started, but
the runtime USB identity never appears.  Log the raw bus interrupt and MUSB
role state immediately before and after the generic interrupt handler.  This
distinguishes a missing runtime CONNECT interrupt from a CONNECT event which
the MUSB state machine mishandles.

Signed-off-by: Buildroot Board Support <buildroot@example.com>
---
 drivers/usb/musb/sunxi.c | 30 ++++++++++++++++++++++++++++++
 1 file changed, 30 insertions(+)

diff --git a/drivers/usb/musb/sunxi.c b/drivers/usb/musb/sunxi.c
index 832a41f..3333333 100644
--- a/drivers/usb/musb/sunxi.c
+++ b/drivers/usb/musb/sunxi.c
@@ -166,6 +166,8 @@ static irqreturn_t sunxi_musb_interrupt(int irq, void *__hci)
 {
 	struct musb *musb = __hci;
 	unsigned long flags;
+	u8 trace_devctl = 0, trace_power = 0;
+	bool trace_bus_event;
 
 	spin_lock_irqsave(&musb->lock, flags);
 
@@ -188,8 +190,36 @@ static irqreturn_t sunxi_musb_interrupt(int irq, void *__hci)
 	if (musb->int_rx)
 		writew(musb->int_rx, musb->mregs + SUNXI_MUSB_INTRRX);
 
+	trace_bus_event = musb->int_usb & (MUSB_INTR_CONNECT |
+						 MUSB_INTR_DISCONNECT |
+						 MUSB_INTR_VBUSERROR |
+						 MUSB_INTR_SESSREQ |
+						 MUSB_INTR_RESET);
+	if (trace_bus_event) {
+		trace_devctl = musb_readb(musb->mregs, MUSB_DEVCTL);
+		trace_power = musb_readb(musb->mregs, MUSB_POWER);
+		dev_warn(musb->controller,
+			 "musb-bustrace before usb=%02x tx=%04x rx=%04x "
+			 "devctl=%02x power=%02x host=%u active=%u state=%u "
+			 "port=%08x\n",
+			 musb->int_usb, musb->int_tx, musb->int_rx,
+			 trace_devctl, trace_power, is_host_active(musb),
+			 musb->is_active, musb->xceiv->otg->state,
+			 musb->port1_status);
+	}
+
 	musb_interrupt(musb);
 
+	if (trace_bus_event)
+		dev_warn(musb->controller,
+			 "musb-bustrace after usb=%02x devctl=%02x power=%02x "
+			 "host=%u active=%u state=%u port=%08x\n",
+			 musb->int_usb,
+			 musb_readb(musb->mregs, MUSB_DEVCTL),
+			 musb_readb(musb->mregs, MUSB_POWER),
+			 is_host_active(musb), musb->is_active,
+			 musb->xceiv->otg->state, musb->port1_status);
+
 	spin_unlock_irqrestore(&musb->lock, flags);
 
 	return IRQ_HANDLED;
-- 
